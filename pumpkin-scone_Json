{
        "title": "9-Free Pumpkin Scones",
        "mainImageUrl": "https://www.allergicliving.com/wp-content/uploads/2022/11/pumpkin.scones.drip_.5x7-731x1024-1.jpg",
        "ingredients": [
            {
                "ingredient": "2 cups gluten-free flour blend (if no xathan gum in blend, add 1 tsp)"
            }, {
                "ingredient": "½ cup sugar"
            }, {
                "ingredient": "1 tbsp baking powder"
            }, {
                "ingredient": "1/2 tsp salt"
            }, {
                "ingredient": "1 1/2 tsp pumpkin spice"
            }, {
                "ingredient": "6 tbsp coconut oil, chilled"
            }, {
                "ingredient": "3/4 cup pumpkin puree"
            }, {
                "ingredient": "3 tbsp rice milk"
            }, {
                "ingredient": "1 tsp vanilla"
            }, {
                "ingredient": "1/2 cup powdered (confectioners’) sugar"
            }, {
                "ingredient": "2 tsp rice milk"
            }, {
                "ingredient": "1/2 tsp ground cinnamon"
            }, {
                "ingredient": "1/4 tsp pumpkin spice"
            }
        ],
        "utensils": [
            {
                "utensil": "8x8-inch pan"
            }, {
                "utensil": "Spatula or wooden spoon"
            }, {
                "utensil": "Fork"
            }
            
        ],
        "steps": [
            {
                "stepDesc": "Preheat your oven to 425 degrees F. Line a baking sheet with parchment paper.",
                "order": 1,
                "orderNum": 1

            }, {
                "stepDesc": "In a large bowl, whisk the flour blend, sugar, baking powder, salt and pumpkin spice, until all are combined.",
                "order": 2,
                "orderNum": 2
            }, {
                "stepDesc": "Remove chilled coconut oil from refrigerator and place into the mixture. Using a fork or pastry blender, work the coconut oil into the mixture. It should be incorporated enough that it looks like crumbly sand – but don’t over-mix it.",
                "order": 3,
                "orderNum": 3
            }, {
                "stepDesc": "Now, add the pumpkin puree, rice milk and vanilla. Using a spatula, fold everything together. The dough will feel a little bit dry and sticky. Also, it’s OK if it’s not perfectly mixed.",
                "order": 4,
                "orderNum": 4
            }, {
                "stepDesc": "Drop the dough onto a lightly floured (with more gluten-free flour) workspace. Shape it into a large circle, about 8 to 9 inches in diameter. Using a pizza cutter, cut the dough into 8 slices. As shown in the video, place the slices on the baking sheet lined with parchment paper. Make sure the slices are not touching each other.",
                "order": 5,
                "orderNum": 5
            }, {
                "stepDesc": "Bake 14-16 minutes until the scones are light brown. Remove from the oven and allow them to cool on a wire rack.",
                "order": 6,
                "orderNum": 6
            }, {
                "stepDesc": "For glaze: As the scones bake, prepare the glaze. In a medium bowl, whisk together powdered sugar, milk (start with just 1 teaspoon), and spices. Add more milk, as needed, while whisking, until you reach the desired consistency. (I prefer a thicker glaze.)",
                "order": 7,
                "orderNum": 7
            }, {
                "stepDesc": "Once the scones have cooled, drizzle with glaze. Serve and enjoy.",
                "order": 8,
                "orderNum": 8
            }
 ],
        "tags": [
            {
                "tag": "Gluten Free"
            }, 
            {
                "tag": "Vegan"
            }
        ]
}
