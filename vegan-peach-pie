{
        "title": "Vegan Peach Pie",
        "mainImageUrl": "https://www.thespruceeats.com/thmb/s16fgWDpGBER64khGpiZGch8mp0=/750x0/filters:no_upscale():max_bytes(150000):strip_icc()/Peachpie-GettyImages-90042304-59b21b8faad52b0011c3855c.jpg",
        "ingredients": [
            {
                "ingredient": "1 dairy-free pie crust"
            }, {
                "ingredient": "5½ cups peeled fresh peach slices"
            }, {
                "ingredient": "1 teaspoon lemon juice"
            }, {
                "ingredient": "1/3 cup all-purpose flour"
            }, {
                "ingredient": "3/4 cup unrefined cane sugar, or white granulated sugar, plus more for sprinkling","
            }, {
                "ingredient": "1/2 teaspoon cinnamon"
            }, {
                "ingredient": "1/4 teaspoon salt"
            }, {
                "ingredient": "2 tablespoons unsweetened soy milk, for brushing"
            }
        ],
        "utensils": [
            {
                "utensil": "9-inch pie pan"
            }, {
                "utensil": "Flour Sifter"
            }, {
                "utensil": "Pastry Brush"
            }
        ],
        "steps": [
            {
                "stepDesc": "Gather the ingredients.",
                "order": 1,
                "orderNum": 1

            }, {
                "stepDesc": "Lightly grease a 9-inch pie plate with soy margarine or any plant-based vegan margarine.",
                "order": 2,
                "orderNum": 2
            }, {
                "stepDesc": "Roll out half of the pie dough, and fit into the pie plate. Using your fingers, create a crust around the edge. Place the pie plate, uncovered, in the freezer for 15 minutes.",
                "order": 3,
                "orderNum": 3
            }, {
                "stepDesc": "Preheat the oven to 400 F. Place the peaches in a large mixing bowl, and toss with the lemon juice.",
                "order": 4,
                "orderNum": 4
            }, {
                "stepDesc": "In another small bowl, sift together the flour, sugar, cinnamon, and salt.",
                "order": 5,
                "orderNum": 5
            }, {
                "stepDesc": "Toss over the peaches and mix gently until evenly incorporated.",
                "order": 6,
                "orderNum": 6
            }, {
                "stepDesc": "Pour the mixture into the prepared pie crust.",
                "order": 7,
                "orderNum": 7
            }, {
                "stepDesc": "Roll out the remaining pie dough and fit over the top of the pie, folding the edges under. Using your fingers or a fork, flute the edges to seal.",
                "order": 8,
                "orderNum": 8
            }, {
                "stepDesc": "Lightly brush the top crust with soy milk and sprinkle with sugar.",
                "order": 9,
                "orderNum": 9
            }, {
                "stepDesc": "Bake for 10 minutes, then turn down the heat to 350 F and bake for 30 to 35 minutes more.",
                "order": 10,
                "orderNum": 10
            }, {
                "stepDesc": "Allow the pie to cool on a wire cooling rack. Serve warm or cold.",
                "order": 11,
                "orderNum": 11
            }
 ],
